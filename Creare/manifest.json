{
  "manifest_version": 3,
  "name": "Creare - Colinha",
  "version": "1.0.4",
  "description": "Colinha da Creare: copia informações de alertas com emojis, cola textos padrão e grupos de emails. Criado por Douglas G.",
  "author": "Douglas G.",
  "permissions": [
    "clipboardWrite",
    "storage",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.goawakecloud.com.br/*"],
      "js": ["textos-padrao.js", "content.js", "auto-click-invalidar.js", "updater.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ]
}
