{
  "manifest_version": 3,
  "name": "Sighra - Colinha",
  "version": "2.2.2",
  "description": "Colinha do Sighra: copia as informacoes da infracao organizadas e cola tratativas na Observacao. Criado por Douglas G.",
  "author": "Douglas G.",
  "permissions": [
    "clipboardWrite",
    "storage",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://192.168.0.84/*"
      ],
      "js": ["content.js", "updater.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ]
}
